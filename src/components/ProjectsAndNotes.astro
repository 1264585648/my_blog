---
import SectionTitle from './SectionTitle.astro';
import { projects } from '../data/home';
import { withBase } from '../utils/paths';
---
<section class="section shell projects-section">
  <SectionTitle title="Selected Projects" href="/projects/" linkText="全部项目 →" />
  <div class="project-list">
    {projects.map((project, index) => (
      <article class="project-row">
        <div class="project-visual">
          <img src={withBase(project.cover)} alt="" />
        </div>
        <div class="project-content">
          <div class="project-number">0{index + 1}</div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tag-row">{project.tags.map((tag) => <span>{tag}</span>)}</div>
          <a class="project-link" href={withBase('/projects/')}>查看项目 <span>↗</span></a>
        </div>
      </article>
    ))}
  </div>
</section>
