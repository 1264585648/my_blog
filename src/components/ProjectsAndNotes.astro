---
import SectionTitle from './SectionTitle.astro';
import { projects, notes } from '../data/home';
import { withBase } from '../utils/paths';
---
<section class="section shell projects-section">
  <div class="projects-head"><SectionTitle title="项目手记" href="/projects/" linkText="查看全部项目 →" /></div>
  <div class="project-layout">
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <img src={withBase(project.cover)} alt="" />
          <div class="project-content">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tag-row">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            <time datetime={project.date}>{project.date}</time>
          </div>
        </article>
      ))}
    </div>

    <aside class="notes-panel">
      <div class="notes-tape"></div>
      <h3>碎片笔记</h3>
      <ul>
        {notes.map(([title, date]) => (
          <li><a href={withBase('/articles/')}><span>{title}</span><time>{date}</time></a></li>
        ))}
      </ul>
      <a class="notes-more" href={withBase('/articles/')}>查看全部笔记 →</a>
    </aside>
  </div>
</section>
