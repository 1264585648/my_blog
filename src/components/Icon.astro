---
interface Props {
  name: 'agent' | 'prompt' | 'rag' | 'build' | 'leaf' | 'search' | 'github' | 'mail';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---
<span class="icon" aria-hidden="true" style={`--icon-size:${size}px`}>
  {name === 'leaf' && (
    <svg viewBox="0 0 24 24"><path d="M4 19c5-1 9-5 11-11 2 5 1 10-3 12-2 1-5 1-8-1Z"/><path d="M8 17c2-3 5-6 9-8"/></svg>
  )}
  {name === 'agent' && (
    <svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="11" rx="4"/><path d="M12 4v3M9 12h.01M15 12h.01M8 16c2 1 6 1 8 0"/><path d="M3 11h2M19 11h2"/></svg>
  )}
  {name === 'prompt' && (
    <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>
  )}
  {name === 'rag' && (
    <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 5 5M7 8h6M7 11h4"/></svg>
  )}
  {name === 'build' && (
    <svg viewBox="0 0 24 24"><path d="M14 5a5 5 0 0 0-6 6L3 16l5 5 5-5a5 5 0 0 0 6-6l-3 3-3-3 3-3-2-2Z"/></svg>
  )}
  {name === 'search' && (
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
  )}
  {name === 'github' && (
    <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-3 17.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.8 9.8 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7 1 .7 2V20c0 .3.2.6.7.5A9 9 0 0 0 12 3Z"/></svg>
  )}
  {name === 'mail' && (
    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
  )}
</span>

<style>
  .icon{display:inline-flex;width:var(--icon-size);height:var(--icon-size);color:currentColor}
  svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
</style>
