---
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';
import { learningPath } from '../data/home';
import { withBase } from '../utils/paths';
---
<section class="section shell learning-section">
  <SectionTitle title="学习路径" href="/learning/" linkText="查看完整路径 →" />
  <div class="learning-track">
    {learningPath.map((step) => (
      <a class={`learning-card ${step.tone}`} href={withBase('/learning/')}>
        <span class="step-head">
          <span class="step-index">{step.index}</span>
          <span class="step-icon" aria-hidden="true"><Icon name={step.icon} size={22} /></span>
        </span>
        <span class="step-copy">
          <strong>{step.title}</strong>
          <small>{step.description}</small>
        </span>
      </a>
    ))}
  </div>
</section>
