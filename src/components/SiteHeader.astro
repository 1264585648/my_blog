---
import Icon from './Icon.astro';
import { stripBase, withBase } from '../utils/paths';

const pathname = stripBase(Astro.url.pathname);
const nav = [
  ['首页', '/'],
  ['学习路径', '/learning/'],
  ['文章', '/articles/'],
  ['项目', '/projects/'],
  ['关于我', '/about/']
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="xuan.z 的个人笔记首页">
      <span class="brand-mark"><Icon name="leaf" size={30} /></span>
      <span class="brand-copy">
        <strong>xuan.z 的个人笔记</strong>
        <small>记录学习，沉淀项目，分享思考</small>
      </span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      {nav.map(([label, href]) => (
        <a class:list={[pathname === href && 'active']} href={withBase(href)}>{label}</a>
      ))}
    </nav>

    <a class="search-link" href={withBase('/articles/')} aria-label="搜索文章">
      <Icon name="search" size={24} />
    </a>
  </div>
</header>
