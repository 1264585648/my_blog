---
import { stripBase, withBase } from '../utils/paths';

const pathname = stripBase(Astro.url.pathname);
const nav = [
  ['文章', '/articles/'],
  ['学习', '/learning/'],
  ['项目', '/projects/'],
  ['关于', '/about/']
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label="xuan.z 的个人笔记首页">
      <span class="brand-word">xuan.z</span>
      <span class="brand-leaf" aria-hidden="true"></span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      {nav.map(([label, href]) => (
        <a class:list={[pathname.startsWith(href) && 'active']} href={withBase(href)}>{label}</a>
      ))}
    </nav>
  </div>
</header>
