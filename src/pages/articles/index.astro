---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/home';
import { withBase } from '../../utils/paths';
---
<BaseLayout title="文章 · xuan.z 的个人笔记">
  <section class="simple-page shell">
    <p class="page-kicker">Writing</p>
    <h1>文章</h1>
    <p class="page-lead">长一点的学习笔记和项目记录都放这里。很多文章会边学边改，不一定一次写完。</p>
    <div class="simple-list">
      {articles.map((article) => <a href={withBase(article.href)}><span><strong>{article.title}</strong><small>{article.excerpt}</small></span><time>{article.date}</time></a>)}
    </div>
  </section>
</BaseLayout>
