---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/home';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.href.split('/').filter(Boolean).pop() },
    props: { article }
  }));
}

const { article } = Astro.props;
---
<BaseLayout title={`${article.title} · xuan.z 的个人笔记`} description={article.excerpt}>
  <article class="article-page shell">
    <a class="article-back" href={withBase('/articles/')}>← 返回文章</a>
    <p class="page-kicker">Essay</p>
    <h1>{article.title}</h1>
    <div class="article-meta"><time>{article.date}</time><span>·</span><span>还在写</span></div>
    <img class="article-hero-cover" src={withBase(article.cover)} alt="" />
    <div class="prose">
      <p>{article.excerpt}</p>
      <p>这篇还没整理完。现在先占个位置，等我把代码、踩坑记录和例子补齐再继续写。</p>
      <h2>准备补什么</h2>
      <p>会尽量把当时怎么做、哪里出过问题、最后为什么这么改写清楚，不只留结论。</p>
    </div>
  </article>
</BaseLayout>
